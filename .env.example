# หลังจากเชื่อม Upstash Redis ผ่าน Vercel Storage แล้ว
# ตัวแปร 2 ตัวนี้จะถูกใส่ให้อัตโนมัติเวลา deploy บน Vercel
# ไฟล์นี้ (.env.local) ใช้เฉพาะตอนรันในเครื่องตัวเอง (npm run dev)
# ก็อปค่าจริงจากหน้า Vercel dashboard > โปรเจกต์ > Settings > Environment Variables มาใส่แทน

KV_REST_API_URL=
KV_REST_API_TOKEN=

# รหัส PIN สำหรับเข้าหน้าแอดมิน ตั้งเองได้ตามต้องการ (ตัวเลขกี่หลักก็ได้)
# ต้องไปเพิ่มตัวแปรนี้เองใน Vercel dashboard > Settings > Environment Variables
# (ไม่ได้ถูกใส่ให้อัตโนมัติเหมือนสองตัวข้างบน เพราะเป็นรหัสของร้านเอง ไม่ใช่ค่าจากฐานข้อมูล)
ADMIN_PIN=
